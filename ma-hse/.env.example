# App
NODE_ENV=development
APP_ENV=development
# Optional: next.config.ts resolves the current local Git commit automatically when omitted.
GIT_COMMIT=
APP_URL=https://maxsafety.maportugal.com
NEXT_PUBLIC_APP_URL=https://maxsafety.maportugal.com
NEXTAUTH_URL=https://maxsafety.maportugal.com
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3004
NEXTAUTH_SECRET=replace-with-strong-secret
TOKEN_PEPPER=replace-with-long-random-pepper
# Report QR rotation is disabled by default. See docs/report-qr-regeneration.md.
REPORT_QR_REGENERATION_ENABLED=false

# Database
DATABASE_URL=postgresql://ehs:ehs@localhost:5433/ehs

# Redis
REDIS_URL=redis://localhost:6380

# SMTP (kept only as the delivery path for emails with attachments)
SMTP_HOST=posta2.it.ma.gruppocln.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Safety Report <safetyreport@pt.ma.gruppocln.com>"

# SMTP gateway (exclusive path for every email, including attachments)
SMTP_GATEWAY_BASE_URL=https://148.69.182.60:8444
SMTP_GATEWAY_API_KEY=

# Optional OpenAI integrations. Server-side only; never expose this as NEXT_PUBLIC.
AGENT_ENABLED=false
AGENT_MOCK_MODE=false
# openai | ollama | anthropic (anthropic uses ANTHROPIC_API_KEY and ANTHROPIC_MODEL)
AGENT_PROVIDER=openai
AGENT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_LOCAL_MODEL=qwen3:1.7b
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_MAX_REQUESTS=20
AGENT_MAX_MESSAGE_CHARS=4000
AGENT_REQUEST_TIMEOUT_MS=30000
AGENT_MAX_TOOL_CALLS=8
AGENT_LOCAL_MAX_TOOL_CALLS=4
AGENT_LOCAL_MAX_OUTPUT_TOKENS=256
AGENT_MAX_OUTPUT_CHARS=4000
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (Claude): structured extraction of historical incident PDFs.
# The report text is sanitized (personal data redacted) before it is sent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# anthropic | ollama | disabled. Empty = legacy: local Ollama only when AGENT_PROVIDER=ollama.
INCIDENT_KNOWLEDGE_EXTRACTION_PROVIDER=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=ehs-attachments
S3_FORCE_PATH_STYLE=true

# Security
RATE_LIMIT_POINTS=60
RATE_LIMIT_WINDOW_SEC=60
AUTH_LOGIN_RATE_LIMIT_POINTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
AUTH_LOGIN_RATE_LIMIT_BURST=3

# Seed defaults
SEED_DEFAULT_PASSWORD=ChangeMe123!
N0_ADMIN_EMAIL=admin@maxsafety.com
