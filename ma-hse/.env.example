RATE_LIMIT_WINDOW_SEC=60
AUTH_LOGIN_RATE_LIMIT_POINTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
AUTH_LOGIN_RATE_LIMIT_BURST=3

# Seed defaults
