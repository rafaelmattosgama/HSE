generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id                                 String                              @id @default(uuid())
  code                               String                              @unique
  name                               String
  timezone                           String
  defaultLanguage                    String
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  isActive                           Boolean                             @default(true)
  actions                            Action[]
  agentPendingConfirmations          AgentPendingConfirmation[]
  alertRules                         AlertRule[]
  areas                              Area[]
  auditLogs                          AuditLog[]
  bodyParts                          BodyPart[]
  communications                     Communication[]
  competenceAlertDeliveries          CompetenceAlertDelivery[]
  competenceAssessments              CompetenceAssessment[]
  competenceWorkerRequirements       CompetenceWorkerRequirement[]
  competenceTypes                    CompetenceType[]
  competenceWorkers                  CompetenceWorker[]
  employees                          EmployeeDirectory[]
  equipments                         Equipment[]
  externalCompanies                  ExternalCompany[]
  externalInvitations                ExternalCompanyInvitation[]
  fireChecklistExecutions            FireChecklistExecution[]
  fireChecklistTemplates             FireChecklistTemplate[]
  fireEquipment                      FireEquipment[]
  fireEquipmentAlertDeliveries       FireEquipmentAlertDelivery[]
  fireEquipmentComplianceStates      FireEquipmentComplianceState[]
  fireEquipmentTagAssignments        FireEquipmentTagAssignment[]
  fireEquipmentTypes                 FireEquipmentType[]
  injuryTypes                        InjuryType[]
  lines                              Line[]
  mapDocuments                       MapDocument[]
  mapFeatures                        MapFeature[]
  mapLayers                          MapLayer[]
  nearMissTypes                      NearMissType[]
  notifications                      Notification[]
  occupationalHealthWorkers          OccupationalHealthWorker[]
  occupationalHealthExams            OccupationalHealthExam[]
  accessTokens                       PlantAccessToken[]
  monthlyInputs                      PlantMonthlyInput[]
  recipientLists                     ReportRecipientList[]
  reportRuns                         ReportRun[]
  riskThemes                         RiskTheme[]
  sewoRecords                        SEWO[]
  safetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[]
  safetyCommunicationNotifications   SafetyCommunicationNotification[]
  kpiInputs                          SafetyKpiMonthlyInput[]
  shifts                             Shift[]
  smatAudits                         SmatAudit[]
  systemParameters                   SystemParameter[]
  trainingRecords                    TrainingRecord[]
  unsafeActTypes                     UnsafeActType[]
  unsafeCondTypes                    UnsafeConditionType[]
  users                              UserPlantRole[]
  workerAuthorizations               WorkerAuthorization[]
  workerCompetenceStates             WorkerCompetenceState[]
  workstations                       Workstation[]
}

model User {
  id                                        String                              @id @default(uuid())
  email                                     String?                             @unique
  employeeDirectoryId                       String?                             @unique
  passwordHash                              String?
  name                                      String
  language                                  String                              @default("pt")
  isActive                                  Boolean                             @default(true)
  createdAt                                 DateTime                            @default(now())
  updatedAt                                 DateTime                            @updatedAt
  emailVerified                             DateTime?
  image                                     String?
  forcePasswordChange                       Boolean                             @default(false)
  onboardingStatus                          OnboardingStatus                    @default(NOT_STARTED)
  onboardingVersion                         Int                                 @default(0)
  onboardingStartedAt                       DateTime?
  onboardingCompletedAt                     DateTime?
  currentOnboardingStep                     Int                                 @default(0)
  accounts                                  Account[]
  actionClosed                              Action[]                            @relation("ActionClosedBy")
  actionsOwned                              Action[]                            @relation("ActionOwner")
  actionReopened                            Action[]                            @relation("ActionReopenedBy")
  actionAlertDeliveries                     ActionAlertDelivery[]
  actionCoOwned                             ActionCoOwner[]
  actionEvidenceAtt                         ActionEvidenceAttachment[]
  agentPendingConfirmations                 AgentPendingConfirmation[]
  auditLogs                                 AuditLog[]
  authenticators                            Authenticator[]
  manualClosedCommunications                Communication[]                     @relation("ManuallyClosedByUser")
  reportedCommunications                    Communication[]                     @relation("ReporterUser")
  validatedCommunications                   Communication[]                     @relation("ValidatedByUser")
  communicationAtt                          CommunicationAttachment[]
  occupationalHealthWorkerAttachments        OccupationalHealthWorkerAttachment[]
  occupationalHealthExamAttachments          OccupationalHealthExamAttachment[]
  contractorCompanies                       ExternalCompany[]                   @relation("ExternalContractorOwner")
  reviewedExternalCompanyDocuments          ExternalCompanyDocument[]           @relation("ExternalCompanyDocumentReviewer")
  contractorInvitationsSent                 ExternalCompanyInvitation[]         @relation("ExternalInvitationSponsor")
  reviewedExternalWorkerDocuments           ExternalWorkerDocument[]            @relation("ExternalWorkerDocumentReviewer")
  notifications                             Notification[]
  sewoApproved                              SEWO[]                              @relation("SewoApprovedBy")
  sewoDeleted                               SEWO[]                              @relation("SewoDeletedBy")
  sewoPerformed                             SEWO[]                              @relation("SewoPerformedBy")
  sewoAttachment                            SEWOAttachment[]
  createdSafetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientCreatedBy")
  updatedSafetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientUpdatedBy")
  safetyCommunicationAlertRecipients        SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientUser")
  safetyCommunicationNotifications          SafetyCommunicationNotification[]   @relation("SafetyCommunicationNotificationRecipient")
  sessions                                  Session[]
  smatAuditsCreated                         SmatAudit[]                         @relation("SMATAuditorUser")
  smatAttachment                            SmatAuditAttachment[]
  addedCompetenceWorkers                    CompetenceWorker[]                  @relation("CompetenceWorkerAddedBy")
  setCompetenceWorkerRequirements           CompetenceWorkerRequirement[]       @relation("CompetenceWorkerRequirementSetBy")
  createdFireEquipment                      FireEquipment[]                     @relation("FireEquipmentCreatedBy")
  performedFireChecklistExecutions          FireChecklistExecution[]            @relation("FireChecklistExecutionPerformedBy")
  assignedFireEquipmentTags                 FireEquipmentTagAssignment[]        @relation("FireEquipmentTagAssignedBy")
  employeeDirectory                         EmployeeDirectory?                  @relation(fields: [employeeDirectoryId], references: [id])
  competenceAssessmentsPerformed            CompetenceAssessment[]
  authorizationsGranted                     WorkerAuthorization[]               @relation("AuthorizationGrantedBy")
  authorizationsSuspended                   WorkerAuthorization[]               @relation("AuthorizationSuspendedBy")
  authorizationsRevoked                     WorkerAuthorization[]               @relation("AuthorizationRevokedBy")
  authorizationsReactivated                 WorkerAuthorization[]               @relation("AuthorizationReactivatedBy")
  trainingRecordAttachmentsUploaded         TrainingRecordAttachment[]
  competenceAssessmentAttachmentsUploaded   CompetenceAssessmentAttachment[]
  competenceAlertDeliveries                 CompetenceAlertDelivery[]
  fireEquipmentAlertDeliveries              FireEquipmentAlertDelivery[]
  plantRoles                                UserPlantRole[]
}

model Role {
  id        String          @id @default(uuid())
  code      RoleCode        @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     UserPlantRole[]
}

model UserPlantRole {
  id        String   @id @default(uuid())
  userId    String
  plantId   String?
  roleId    String
  createdAt DateTime @default(now())
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId, roleId])
  @@index([plantId])
  @@index([roleId])
}

model PlantAccessToken {
  id        String               @id @default(uuid())
  plantId   String
  type      PlantAccessTokenType
  tokenHash String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  revokedAt DateTime?
  createdBy String?
  plant     Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, type, tokenHash])
  @@index([plantId, type, isActive])
}

model Area {
  id                                 String                              @id @default(uuid())
  plantId                            String
  code                               String
  name                               String
  isActive                           Boolean                             @default(true)
  sourceLanguage                     String?
  plant                              Plant                               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  communications                     Communication[]
  competenceWorkers                  CompetenceWorker[]
  fireEquipment                      FireEquipment[]
  mapFeatures                        MapFeature[]
  sewoRecords                        SEWO[]
  safetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientDepartment")
  safetyCommunicationNotifications   SafetyCommunicationNotification[]   @relation("SafetyCommunicationNotificationDepartment")

  @@unique([plantId, code])
}

model Line {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sewoRecords    SEWO[]

  @@unique([plantId, code])
}

model Workstation {
  id                        String                     @id @default(uuid())
  plantId                   String
  code                      String
  name                      String
  isActive                  Boolean                    @default(true)
  sourceLanguage            String?
  communications            Communication[]
  fireEquipment             FireEquipment[]
  mapFeatures               MapFeature[]
  occupationalHealthWorkers OccupationalHealthWorker[]
  plant                     Plant                      @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model OccupationalHealthWorker {
  id                  String       @id @default(uuid())
  plantId             String
  employeeDirectoryId String?      @unique
  employeeNo          String
  name                String
  birthDate           DateTime
  workstationId       String?
  gender              String
  hireDate            DateTime
  roleStartDate       DateTime
  roleName            String?
  nationality         String?
  /// Legacy summary fields are retained for backwards compatibility. New
  /// reads use the most recent OccupationalHealthExam instead.
  examDate            DateTime?
  validUntil          DateTime?
  status              String       @default("VALID")
  observation         String?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  plant               Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  employeeDirectory   EmployeeDirectory? @relation(fields: [employeeDirectoryId], references: [id], onDelete: SetNull)
  workstation         Workstation? @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  attachments         OccupationalHealthWorkerAttachment[]
  exams               OccupationalHealthExam[]

  @@unique([plantId, employeeNo])
  @@index([plantId, isActive, examDate])
  @@index([plantId, employeeDirectoryId])
}

/// PDF/image documents attached to a worker's occupational health record —
/// additive only (no delete/replace flow yet, mirrors the minimal scope
/// actually requested). Same shape as CommunicationAttachment/SEWOAttachment;
/// viewed via a nested GET route that streams the object inline, not a
/// bare fileKey column (see fire-equipment-service.ts's own note on why a
/// lone fileKey field never gets a working view mechanism).
model OccupationalHealthWorkerAttachment {
  id                          String                   @id @default(uuid())
  occupationalHealthWorkerId  String
  fileKey                     String
  fileName                    String
  contentType                 String
  createdAt                   DateTime                 @default(now())
  uploadedById                String?

  occupationalHealthWorker OccupationalHealthWorker @relation(fields: [occupationalHealthWorkerId], references: [id], onDelete: Cascade)
  uploadedBy               User?                     @relation(fields: [uploadedById], references: [id])

  @@index([occupationalHealthWorkerId])
}

/// Each clinical examination belongs to the stable occupational-health worker
/// record. This deliberately does not use employeeNo: Admin can change that
/// number without breaking the medical history.
model OccupationalHealthExam {
  id                         String   @id @default(uuid())
  plantId                    String
  occupationalHealthWorkerId String
  examDate                   DateTime
  validUntil                 DateTime
  status                     String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  plant       Plant                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  worker      OccupationalHealthWorker @relation(fields: [occupationalHealthWorkerId], references: [id], onDelete: Cascade)
  attachments OccupationalHealthExamAttachment[]

  @@index([occupationalHealthWorkerId, examDate])
  @@index([plantId, examDate])
}

/// New documents belong to an examination. The older worker-level table is
/// intentionally retained so its rows can be copied safely during migration.
model OccupationalHealthExamAttachment {
  id                        String                 @id @default(uuid())
  occupationalHealthExamId  String
  fileKey                   String
  fileName                  String
  contentType               String
  createdAt                 DateTime               @default(now())
  uploadedById              String?

  exam       OccupationalHealthExam @relation(fields: [occupationalHealthExamId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation(fields: [uploadedById], references: [id])

  @@index([occupationalHealthExamId])
}

model Equipment {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  sourceLanguage String?
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model Shift {
  id             String              @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean             @default(true)
  communications Communication[]
  employees      EmployeeDirectory[]
  sewoRecords    SEWO[]
  plant          Plant               @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model RiskTheme {
  id                     String          @id @default(uuid())
  plantId                String
  code                   String
  name                   String
  isActive               Boolean         @default(true)
  category               String          @default("General")
  sourceLanguage         String?
  categorySourceLanguage String?
  communications         Communication[]
  plant                  Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model MasterDataTranslation {
  id           String                      @id @default(uuid())
  entityType   MasterDataEntityType
  entityId     String
  field        MasterDataTranslationField  @default(NAME)
  locale       String
  value        String?
  sourceHash   String
  status       MasterDataTranslationStatus @default(PENDING)
  isManual     Boolean                     @default(false)
  attempts     Int                         @default(0)
  lastError    String?
  translatedAt DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
  @@index([status, updatedAt])
}

model UnsafeActType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  category       String          @default("General")
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model UnsafeConditionType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  category       String          @default("General")
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model NearMissType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model BodyPart {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  communications Communication[]

  @@unique([plantId, code])
}

model InjuryType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model EmployeeDirectory {
  id                           String                          @id @default(uuid())
  plantId                      String
  employeeNo                   String
  name                         String
  dept                         String?
  shiftId                      String?
  isActive                     Boolean                         @default(true)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  targetCommunications         Communication[]                 @relation("TargetEmployee")
  involvedCommunications       CommunicationInvolvedEmployee[]
  plant                        Plant                           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  shift                        Shift?                          @relation(fields: [shiftId], references: [id])
  contractorCompanyAssignments ExternalCompany[]               @relation("ExternalContractorSponsor")
  competenceWorkers            CompetenceWorker[]
  occupationalHealthWorker     OccupationalHealthWorker?
  linkedUser                   User?

  @@unique([plantId, employeeNo])
  @@index([plantId, name])
}

/// Competence & Authorizations module — phase 1 (catalog + requirement matrix
/// scaffolding + worker enrollment). Training/assessment/authorization records
/// and the state-computation algorithm are introduced in later phases; for now
/// every WorkerCompetenceState is either MISSING (required) or NOT_APPLICABLE.
model CompetenceType {
  id                    String                    @id @default(uuid())
  plantId               String
  code                  String
  name                  String
  category              CompetenceCategory        @default(EQUIPMENT_OPERATION)
  requiresTraining      Boolean                   @default(true)
  requiresAssessment    Boolean                   @default(true)
  requiresAuthorization Boolean                   @default(true)
  validityMonths        Int                       @default(12)
  refresherMonths       Int?
  legalReference        String?
  displayOrder          Int                       @default(0)
  isActive              Boolean                   @default(true)
  sourceLanguage        String?
  plant                 Plant                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  workerRequirements    CompetenceWorkerRequirement[]
  states                WorkerCompetenceState[]
  trainingRecords       TrainingRecord[]
  assessments           CompetenceAssessment[]
  authorizations        WorkerAuthorization[]
  alertDeliveries       CompetenceAlertDelivery[]
  actionLinks           CompetenceActionLink[]

  @@unique([plantId, code])
  @@index([plantId, isActive, displayOrder])
}

enum CompetenceCategory {
  EQUIPMENT_OPERATION
  HIGH_RISK_ACTIVITY
  SAFETY_ROLE
  LEGAL_MANDATORY
  OTHER
}

model CompetenceWorker {
  id                  String   @id @default(uuid())
  plantId             String
  employeeDirectoryId String
  areaId              String?
  roleName            String?
  isActive            Boolean  @default(true)
  addedById           String?
  addedAt             DateTime @default(now())
  updatedAt           DateTime @updatedAt

  plant           Plant                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  employee        EmployeeDirectory         @relation(fields: [employeeDirectoryId], references: [id], onDelete: Cascade)
  area            Area?                     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  addedBy         User?                     @relation("CompetenceWorkerAddedBy", fields: [addedById], references: [id])
  states          WorkerCompetenceState[]
  requirements    CompetenceWorkerRequirement[]
  trainingRecords TrainingRecord[]
  assessments     CompetenceAssessment[]
  authorizations  WorkerAuthorization[]
  alertDeliveries CompetenceAlertDelivery[]
  actionLinks     CompetenceActionLink[]

  @@unique([plantId, employeeDirectoryId])
  @@index([plantId, isActive])
}

model WorkerCompetenceState {
  id                     String              @id @default(uuid())
  plantId                String
  competenceWorkerId     String
  competenceTypeId       String
  isRequired             Boolean             @default(false)
  requirementSource      String?
  state                  CompetenceCellState
  validUntil             DateTime?
  daysToExpiry           Int?
  currentAuthorizationId String?
  blockedReason          String?
  computedAt             DateTime            @default(now())

  plant            Plant            @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType   @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)

  @@unique([competenceWorkerId, competenceTypeId])
  @@index([plantId, state])
  @@index([plantId, validUntil])
}

/// §3.2 (revised): one row per (worker, competenceType), set explicitly by
/// a supervisor who knows that worker's real duties, not inferred from a
/// role-name string match that depended on data nobody kept filled in.
model CompetenceWorkerRequirement {
  id                 String   @id @default(uuid())
  plantId            String
  competenceWorkerId String
  competenceTypeId   String
  isRequired         Boolean  @default(true)
  notes              String?
  setById            String?
  setAt              DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plant            Plant            @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType   @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)
  setBy            User?            @relation("CompetenceWorkerRequirementSetBy", fields: [setById], references: [id])

  @@unique([competenceWorkerId, competenceTypeId])
  @@index([plantId, isRequired])
}

enum CompetenceCellState {
  VALID
  EXPIRING
  EXPIRED
  MISSING
  AWAITING_ASSESSMENT
  AWAITING_AUTHORIZATION
  SUSPENDED
  REVOKED
  NOT_APPLICABLE
}

/// Competence & Authorizations module — phase 2 (the three record levels,
/// the state-computation algorithm and the individual worker profile).
model TrainingRecord {
  id                   String         @id @default(uuid())
  plantId              String
  entryGroupId         String?
  competenceWorkerId   String
  competenceTypeId     String
  provider             String?
  trainerName          String?
  completedAt          DateTime
  durationHours        Decimal?       @db.Decimal(5, 2)
  certificateNumber    String?
  certificateExpiresAt DateTime?
  result               TrainingResult @default(PASSED)
  notes                String?
  createdAt            DateTime       @default(now())
  createdById          String?

  plant            Plant                      @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker           @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType             @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)
  attachments      TrainingRecordAttachment[]
  assessments      CompetenceAssessment[]
  authorizations   WorkerAuthorization[]

  @@index([competenceWorkerId, competenceTypeId, completedAt])
  @@index([entryGroupId])
}

enum TrainingResult {
  PASSED
  FAILED
}

model TrainingRecordAttachment {
  id               String   @id @default(uuid())
  trainingRecordId String
  fileKey          String
  fileName         String
  contentType      String
  caption          String?
  createdAt        DateTime @default(now())
  uploadedById     String?

  trainingRecord TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation(fields: [uploadedById], references: [id])
}

model CompetenceAssessment {
  id                 String                     @id @default(uuid())
  plantId            String
  entryGroupId       String?
  competenceWorkerId String
  competenceTypeId   String
  trainingRecordId   String?
  assessedAt         DateTime
  assessorUserId     String?
  assessorName       String?
  method             CompetenceAssessmentMethod @default(PRACTICAL_TEST)
  result             CompetenceAssessmentResult
  score              Int?
  observations       String?
  createdAt          DateTime                   @default(now())
  createdById        String?

  plant            Plant                            @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker                 @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType                   @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)
  trainingRecord   TrainingRecord?                  @relation(fields: [trainingRecordId], references: [id], onDelete: SetNull)
  assessor         User?                            @relation(fields: [assessorUserId], references: [id])
  attachments      CompetenceAssessmentAttachment[]
  authorizations   WorkerAuthorization[]

  @@index([competenceWorkerId, competenceTypeId, assessedAt])
  @@index([entryGroupId])
}

enum CompetenceAssessmentMethod {
  PRACTICAL_TEST
  OBSERVATION
  THEORY_TEST
  SIMULATOR
}

enum CompetenceAssessmentResult {
  COMPETENT
  NOT_YET_COMPETENT
}

model CompetenceAssessmentAttachment {
  id                     String   @id @default(uuid())
  competenceAssessmentId String
  fileKey                String
  fileName               String
  contentType            String
  caption                String?
  createdAt              DateTime @default(now())
  uploadedById           String?

  competenceAssessment CompetenceAssessment @relation(fields: [competenceAssessmentId], references: [id], onDelete: Cascade)
  uploadedBy           User?                @relation(fields: [uploadedById], references: [id])
}

/// sequenceNumber is a plain max+1 inside the same $transaction, mirroring
/// Action.sequenceNumber — RecordCodeService only covers COMMUNICATION/SEWO/REPORT.
model WorkerAuthorization {
  id                  String              @id @default(uuid())
  plantId             String
  entryGroupId        String?
  competenceWorkerId  String
  competenceTypeId    String
  trainingRecordId    String?
  assessmentId        String?
  sequenceNumber      Int?
  grantedAt           DateTime            @default(now())
  grantedByUserId     String
  validFrom           DateTime
  validUntil          DateTime
  restrictions        String?
  status              AuthorizationStatus @default(ACTIVE)
  documentFileKey     String?
  acknowledgedAt      DateTime?
  suspendedAt         DateTime?
  suspendedByUserId   String?
  suspensionReason    String?
  reactivatedAt       DateTime?
  reactivatedByUserId String?
  revokedAt           DateTime?
  revokedByUserId     String?
  revocationReason    String?
  supersededById      String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  plant             Plant                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker  CompetenceWorker          @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType    CompetenceType            @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)
  trainingRecord    TrainingRecord?           @relation(fields: [trainingRecordId], references: [id], onDelete: SetNull)
  assessment        CompetenceAssessment?     @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  grantedBy         User                      @relation("AuthorizationGrantedBy", fields: [grantedByUserId], references: [id])
  suspendedByUser   User?                     @relation("AuthorizationSuspendedBy", fields: [suspendedByUserId], references: [id])
  revokedByUser     User?                     @relation("AuthorizationRevokedBy", fields: [revokedByUserId], references: [id])
  reactivatedByUser User?                     @relation("AuthorizationReactivatedBy", fields: [reactivatedByUserId], references: [id])
  supersededBy      WorkerAuthorization?      @relation("AuthorizationSupersedes", fields: [supersededById], references: [id])
  supersedes        WorkerAuthorization?      @relation("AuthorizationSupersedes")
  alertDeliveries   CompetenceAlertDelivery[]

  @@unique([plantId, sequenceNumber])
  @@index([plantId, status, validUntil])
  @@index([competenceWorkerId, competenceTypeId, status])
  @@index([entryGroupId])
}

enum AuthorizationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
  SUPERSEDED
}

/// §3.8 / phase 4: delivery log for competence alerts. cycleKey is what makes
/// this idempotent (§7.3) — authorizationId for alerts tied to one, "YYYY-MM"
/// otherwise. competenceWorker/competenceType relations added beyond the
/// doc's literal snippet, mirroring ActionAlertDelivery's own relation to
/// Action — the more consistent precedent for a delivery-log table in this
/// codebase.
model CompetenceAlertDelivery {
  id                 String              @id @default(uuid())
  plantId            String
  competenceWorkerId String
  competenceTypeId   String
  authorizationId    String?
  userId             String
  alertType          CompetenceAlertType
  channel            ActionAlertChannel
  cycleKey           String
  notificationId     String?
  sentAt             DateTime            @default(now())

  plant            Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker     @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType       @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)
  authorization    WorkerAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification     Notification?        @relation(fields: [notificationId], references: [id])

  @@unique([competenceWorkerId, competenceTypeId, userId, alertType, channel, cycleKey])
  @@index([userId, alertType, sentAt])
  @@index([plantId, alertType, sentAt])
}

enum CompetenceAlertType {
  EXPIRING_90
  EXPIRING_60
  EXPIRING_30
  EXPIRING_7
  EXPIRY_DAY
  MISSING_DOCUMENT
  AUTHORIZATION_SUSPENDED
  AUTHORIZATION_REVOKED
  ROLE_WITHOUT_COMPETENCE
  AWAITING_ASSESSMENT
}

/// §3.8 / phase 5 (§8): join table, not a direct FK on Action — mirrors
/// SmatAuditActionLink. Closing the Action never changes WorkerCompetenceState;
/// only a real training/assessment/authorization write does that.
model CompetenceActionLink {
  id                 String   @id @default(uuid())
  actionId           String
  competenceWorkerId String
  competenceTypeId   String
  createdAt          DateTime @default(now())

  action           Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  competenceWorker CompetenceWorker @relation(fields: [competenceWorkerId], references: [id], onDelete: Cascade)
  competenceType   CompetenceType   @relation(fields: [competenceTypeId], references: [id], onDelete: Cascade)

  @@unique([actionId, competenceWorkerId, competenceTypeId])
  @@index([competenceWorkerId, competenceTypeId])
}

/// §9 (phase 5). Mirrors CompetenceActionLink exactly — a plain join, no
/// plantId column of its own (scoped via actionId/fireEquipmentId only).
/// Closing the linked Action never touches FireEquipmentComplianceState —
/// unlike SEWOActionLink/Communication, there is no syncParentStatuses call
/// for this sourceType. The equipment's state only ever changes through a
/// new FireChecklistExecution that resolves the item (§6).
model FireEquipmentActionLink {
  id              String   @id @default(uuid())
  actionId        String
  fireEquipmentId String
  createdAt       DateTime @default(now())

  action        Action        @relation(fields: [actionId], references: [id], onDelete: Cascade)
  fireEquipment FireEquipment @relation(fields: [fireEquipmentId], references: [id], onDelete: Cascade)

  @@unique([actionId, fireEquipmentId])
  @@index([fireEquipmentId])
}

/// Fire Safety Equipment module — phase 1 (catalog + equipment registry +
/// read-only list). Fase 0 confirmed there is no generic Equipment/Asset
/// registry to extend: the existing `Equipment` model (below) is master data
/// used only to tag Communication.equipmentId, with no location, lifecycle,
/// manufacturer/serial fields, or history — a different shape entirely.
/// FireChecklistTemplate/Item/Execution, FireEquipmentComplianceState and
/// FireEquipmentTagAssignment (§3.3-3.6) are added in later phases; the
/// relations they would add to FireEquipmentType/FireEquipment are
/// deliberately not declared yet, since the referenced models don't exist.
model FireEquipmentType {
  id             String                @id @default(uuid())
  plantId        String
  code           String
  name           String
  category       FireEquipmentCategory @default(OTHER)
  codePrefix     String // "EXT", "CAR", "BAE", "CDI" — used to build FireEquipment.internalCode (§2.8)
  legalReference String?
  displayOrder   Int                   @default(0)
  isActive       Boolean               @default(true)
  sourceLanguage String?

  plant              Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  equipments         FireEquipment[]
  checklistTemplates FireChecklistTemplate[]

  @@unique([plantId, code])
  @@index([plantId, isActive, displayOrder])
}

enum FireEquipmentCategory {
  PORTABLE_EXTINCTION
  FIXED_EXTINCTION
  EMERGENCY_LIGHTING
  DETECTION_ALARM
  OTHER
}

/// Fase 0 item 3: Workstation is reused by OccupationalHealthWorker as a
/// "production post/role", not as a free spatial
/// location — areaId/workstationId stay optional qualifiers, locationDescription
/// is the field a caller should actually rely on for common-area equipment
/// (corridors, stairwells) instead of inventing a fictitious Workstation row.
model FireEquipment {
  id                  String              @id @default(uuid())
  plantId             String
  fireEquipmentTypeId String
  // Fase 0 item 4: RecordCodeService is closed to COMMUNICATION/SEWO/REPORT and
  // WorkerAuthorization.sequenceNumber's own max+1 (plantId only, no advisory
  // lock) is itself a known race — this counter is scoped to (plantId,
  // fireEquipmentTypeId) and must only be advanced under
  // pg_advisory_xact_lock (fire-equipment-service.ts).
  sequenceNumber      Int
  // Typed by the user at creation (e.g. matching a physical tag already on
  // the equipment) — see fire-equipment-service.ts's create(). Immutable
  // after creation, same as before, but no longer auto-generated from
  // codePrefix + sequenceNumber; sequenceNumber is kept purely as an
  // internal, advisory-lock-protected counter (§2.8's original rationale).
  internalCode        String
  areaId              String?
  workstationId       String?
  locationDescription String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  capacity            String?
  // "Foto do local": the add-equipment form's own request — a single photo of
  // where the equipment lives, not a multi-attachment gallery. Write-only key,
  // same as WorkerAuthorization.documentFileKey / FireChecklistExecution's own
  // externalCertificateFileKey — no render-URL plumbing exists yet either.
  locationPhotoFileKey String?
  // Only meaningful when fireEquipmentType.code === "EXTINGUISHER" — the
  // service silently drops it for any other type rather than validating.
  extinguishingAgent  FireExtinguishingAgent?
  installedAt         DateTime?
  manufactureDate     DateTime?
  status              FireEquipmentStatus @default(ACTIVE)
  decommissionedAt    DateTime?
  decommissionReason  String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String?

  plant             Plant                         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipmentType FireEquipmentType             @relation(fields: [fireEquipmentTypeId], references: [id], onDelete: Cascade)
  area              Area?                         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  workstation       Workstation?                  @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  createdBy         User?                         @relation("FireEquipmentCreatedBy", fields: [createdById], references: [id])
  executions        FireChecklistExecution[]
  complianceState   FireEquipmentComplianceState?
  tagAssignments    FireEquipmentTagAssignment[]
  alertDeliveries   FireEquipmentAlertDelivery[]
  actionLinks       FireEquipmentActionLink[]

  @@unique([plantId, internalCode])
  @@unique([plantId, fireEquipmentTypeId, sequenceNumber])
  @@index([plantId, fireEquipmentTypeId, isActive])
  @@index([plantId, status])
}

enum FireExtinguishingAgent {
  CO2
  ABC
  ABF
  WATER
}

enum FireEquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

/// §3.3 / phase 3 (NFC/QR). Only one isActive = true row per fireEquipmentId
/// at a time — enforced in fire-equipment-tag-service.ts (read current
/// active row, deactivate it, create the new one, all in one transaction),
/// not only by tagCode's global uniqueness. Replacing a tag never touches
/// FireChecklistExecution/FireEquipmentComplianceState — history and
/// compliance are keyed on fireEquipmentId, never on tagCode (§5.6).
/// Fase 3 (§5.1): the factory's already-installed tags are identified by BOTH
/// tagUid (the chip's hardware serial, read-only, never written) and tagCode
/// (our own 8-char code, written as the NDEF URL's last segment) — resolution
/// always tries tagUid first (§5.1 rule 2). Both are nullable+unique so a row
/// can exist with only one of them (tagUid before the code was minted is
/// never the case in practice, but a CODE_ONLY row from the manual/no-scan
/// path never has a tagUid, and a UID_ONLY row still gets a tagCode minted
/// for a possible backup QR print even though it was never physically
/// written). A cross-equipment TRANSFER nulls out tagUid on the LOSING row
/// (see fire-equipment-tag-service.ts's transferTag) rather than leaving it
/// there — an inactive row must never keep claiming a uid that's active
/// elsewhere, which is what keeps the plain @unique below safe: a straight
/// global-permanent unique (like tagCode already was) would make a
/// transfer's second attempt at binding that same physical tag permanently
/// impossible once the first (now-inactive) row existed.
model FireEquipmentTagAssignment {
  id              String               @id @default(uuid())
  plantId         String
  fireEquipmentId String
  tagUid          String?
  tagCode         String?
  tagType         FireEquipmentTagType @default(NFC_AND_QR)
  // Free text — Web NFC exposes no reliable chip-technology field; this is
  // whatever the person binding the tag chooses to note (e.g. from a
  // separate NFC-inspection app), never auto-detected.
  chipType        String?
  bindingMode     FireTagBindingMode   @default(CODE_ONLY)
  assignedAt      DateTime             @default(now())
  assignedById    String
  writtenAt       DateTime?
  unassignedAt    DateTime?
  unassignReason  String?
  isActive        Boolean              @default(true)

  plant         Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipment FireEquipment @relation(fields: [fireEquipmentId], references: [id], onDelete: Cascade)
  assignedBy    User          @relation("FireEquipmentTagAssignedBy", fields: [assignedById], references: [id])

  @@unique([tagUid])
  @@unique([tagCode])
  @@index([fireEquipmentId, isActive])
}

enum FireEquipmentTagType {
  NFC_AND_QR
  QR_ONLY
}

/// FULL: uid read AND url successfully written to the chip.
/// UID_ONLY: uid read but the chip refused the write (read-only/locked) —
/// tap-to-open never works on iPhone for this tag, only the in-app Android
/// NFC read (uid lookup) or the printed QR.
/// CODE_ONLY: no NFC scan was ever involved (manual code entry, or a fresh
/// label printed for equipment that has no physical tag yet).
enum FireTagBindingMode {
  FULL
  UID_ONLY
  CODE_ONLY
}

/// Fire Safety Equipment module — phase 2 (checklist catalog, execution
/// history, and the derived compliance-state cache). Fase 0/phase 1's own
/// comment above already flagged these relations as deliberately absent
/// until this phase; FireEquipmentTagAssignment (§3.3, NFC/QR) still isn't
/// declared — that's phase 3.
///
/// §3.4 rule (item 3 of the phase-2 brief): once a FireChecklistItem has any
/// FireChecklistItemResponse, its label/responseType must never be edited in
/// place — deactivate it (isActive = false) and create a new item with a
/// different code instead. Nothing in the schema enforces this; it's a
/// service-layer rule (fire-equipment-service.ts / a future admin route).
model FireChecklistTemplate {
  id                  String                 @id @default(uuid())
  plantId             String
  fireEquipmentTypeId String
  frequency           FireChecklistFrequency
  name                String
  legalReference      String?
  version             Int                    @default(1)
  isActive            Boolean                @default(true)
  sourceLanguage      String?
  createdAt           DateTime               @default(now())

  plant             Plant                    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipmentType FireEquipmentType        @relation(fields: [fireEquipmentTypeId], references: [id], onDelete: Cascade)
  items             FireChecklistItem[]
  executions        FireChecklistExecution[]

  @@unique([plantId, fireEquipmentTypeId, frequency])
  @@index([plantId, fireEquipmentTypeId, frequency, isActive])
}

enum FireChecklistFrequency {
  QUARTERLY
  ANNUAL
}

model FireChecklistItem {
  id           String                        @id @default(uuid())
  templateId   String
  code         String
  label        String
  helpText     String?
  responseType FireChecklistItemResponseType @default(OK_NOK)
  isCritical   Boolean                       @default(false)
  displayOrder Int                           @default(0)
  isActive     Boolean                       @default(true)

  template  FireChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses FireChecklistItemResponse[]

  @@unique([templateId, code])
  @@index([templateId, isActive, displayOrder])
}

enum FireChecklistItemResponseType {
  OK_NOK
  OK_NOK_NA
  NUMERIC
  TEXT
}

/// overallResult is always computed in fire-equipment-service.ts from
/// itemResponses (§3.5) — never accepted as a free field from the client.
model FireChecklistExecution {
  id                         String                 @id @default(uuid())
  plantId                    String
  fireEquipmentId            String
  templateId                 String
  frequency                  FireChecklistFrequency
  scheduledFor               DateTime?
  performedAt                DateTime               @default(now())
  performedByUserId          String
  performedViaTag            Boolean                @default(false)
  externalProviderName       String?
  externalCertificateFileKey String?
  overallResult              FireChecklistResult
  observations               String?
  createdAt                  DateTime               @default(now())

  plant           Plant                              @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipment   FireEquipment                      @relation(fields: [fireEquipmentId], references: [id], onDelete: Cascade)
  template        FireChecklistTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  performedBy     User                               @relation("FireChecklistExecutionPerformedBy", fields: [performedByUserId], references: [id])
  itemResponses   FireChecklistItemResponse[]
  attachments     FireChecklistExecutionAttachment[]
  alertDeliveries FireEquipmentAlertDelivery[]

  @@index([fireEquipmentId, frequency, performedAt])
  @@index([plantId, overallResult, performedAt])
}

enum FireChecklistResult {
  PASSED
  PASSED_WITH_OBSERVATIONS
  FAILED
}

model FireChecklistItemResponse {
  id           String                 @id @default(uuid())
  executionId  String
  itemId       String
  value        FireChecklistItemValue
  numericValue Decimal?               @db.Decimal(8, 2)
  textValue    String?
  notes        String?

  execution FireChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  item      FireChecklistItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([executionId, itemId])
}

enum FireChecklistItemValue {
  OK
  NOK
  NOT_APPLICABLE
}

model FireChecklistExecutionAttachment {
  id          String   @id @default(uuid())
  executionId String
  fileKey     String
  fileName    String
  uploadedAt  DateTime @default(now())

  execution FireChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

/// Cache of derived compliance state per equipment, recomputed inside the
/// same $transaction as a FireChecklistExecution write (§3.6). No daily job
/// yet (that's phase 4, mirroring WorkerCompetenceState's own precedent in
/// the Competences module) — a row goes stale only for date-based
/// transitions (VALID → DUE_SOON → OVERDUE) between executions, not for
/// anything execution-driven. Equipment with no row yet (never had any
/// execution) is treated as NEVER_DONE/NEVER_DONE by the service's read
/// path rather than backfilled.
model FireEquipmentComplianceState {
  id                       String                  @id @default(uuid())
  plantId                  String
  fireEquipmentId          String                  @unique
  quarterlyState           FireComplianceCellState
  quarterlyDueDate         DateTime?
  quarterlyLastExecutionId String?
  annualState              FireComplianceCellState
  annualDueDate            DateTime?
  annualLastExecutionId    String?
  hasOpenNonConformity     Boolean                 @default(false)
  computedAt               DateTime                @default(now())

  plant         Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipment FireEquipment @relation(fields: [fireEquipmentId], references: [id], onDelete: Cascade)

  @@index([plantId, quarterlyState])
  @@index([plantId, annualState])
}

enum FireComplianceCellState {
  VALID
  DUE_SOON
  OVERDUE
  NEVER_DONE
  NOT_APPLICABLE
}

/// §8 (alerts, phase 4). Mirrors CompetenceAlertDelivery's role in the
/// Competences module exactly — same P2002-as-idempotency-guard pattern in
/// fire-equipment-alert-service.ts. cycleKey for DUE_SOON/OVERDUE is
/// "fireEquipmentId:frequency:dueDateIso" (§8), so a fresh due date — set
/// only by a new FireChecklistExecution — is free to alert again even
/// inside the same warning window; TAG_MISSING's cycleKey is "YYYY-MM"
/// (Europe/Lisbon), relying on fireEquipmentId already being a separate
/// column of the @@unique below to scope it per equipment rather than
/// folding the id into the string itself; NON_CONFORMITY_FOUND's is the
/// triggering execution's id.
model FireEquipmentAlertDelivery {
  id              String                 @id @default(uuid())
  plantId         String
  fireEquipmentId String
  executionId     String?
  userId          String
  alertType       FireEquipmentAlertType
  channel         ActionAlertChannel
  cycleKey        String
  notificationId  String?
  sentAt          DateTime               @default(now())

  plant         Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  fireEquipment FireEquipment           @relation(fields: [fireEquipmentId], references: [id], onDelete: Cascade)
  execution     FireChecklistExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification  Notification?           @relation(fields: [notificationId], references: [id])

  @@unique([fireEquipmentId, userId, alertType, channel, cycleKey])
  @@index([userId, alertType, sentAt])
  @@index([plantId, alertType, sentAt])
}

enum FireEquipmentAlertType {
  DUE_SOON
  OVERDUE
  TAG_MISSING
  NON_CONFORMITY_FOUND
}

model Communication {
  id                               String                            @id @default(uuid())
  plantId                          String
  type                             CommunicationType
  status                           CommunicationStatus               @default(SUBMITTED)
  source                           CommunicationSource               @default(BACKOFFICE)
  eventDatetime                    DateTime
  reportedAt                       DateTime                          @default(now())
  reporterName                     String
  reporterEmployeeNo               String?
  reporterUserId                   String?
  targetText                       String?
  targetEmployeeNo                 String?
  targetEmployeeId                 String?
  areaId                           String?
  lineId                           String?
  workstationId                    String?
  equipmentId                      String?
  riskThemeId                      String?
  unsafeActTypeId                  String?
  unsafeConditionTypeId            String?
  nearMissTypeId                   String?
  description                      String
  severityPotential                SeverityPotential?
  isContractor                     Boolean?                          @default(false)
  bodyPartId                       String?
  injuryTypeId                     String?
  hasLeave                         Boolean?                          @default(false)
  returnDate                       DateTime?
  lostDays                         Int?
  classification                   LeaveClassification?
  validationNotes                  String?
  validatedBy                      String?
  validatedAt                      DateTime?
  invalidationReason               String?
  manuallyClosedBy                 String?
  manuallyClosedAt                 DateTime?
  manualCloseReason                String?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  suggestedAction                  String?
  isFatal                          Boolean?                          @default(false)
  initialLostDays                  Int?
  shiftId                          String?
  level                            RecordLevel?
  improvementSubtype               CommunicationImprovementSubtype?
  codigoCompleto                   String?                           @unique
  codigoAbreviado                  String?
  tipo                             String?
  codigoFabrica                    String?
  ano                              Int?
  numeroSequencial                 Int?
  actions                          Action[]
  alertEvents                      AlertEvent[]
  area                             Area?                             @relation(fields: [areaId], references: [id])
  bodyPart                         BodyPart?                         @relation(fields: [bodyPartId], references: [id])
  equipment                        Equipment?                        @relation(fields: [equipmentId], references: [id])
  injuryType                       InjuryType?                       @relation(fields: [injuryTypeId], references: [id])
  line                             Line?                             @relation(fields: [lineId], references: [id])
  manuallyClosedByUser             User?                             @relation("ManuallyClosedByUser", fields: [manuallyClosedBy], references: [id])
  nearMissType                     NearMissType?                     @relation(fields: [nearMissTypeId], references: [id])
  plant                            Plant                             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  reporterUser                     User?                             @relation("ReporterUser", fields: [reporterUserId], references: [id])
  riskTheme                        RiskTheme?                        @relation(fields: [riskThemeId], references: [id])
  shift                            Shift?                            @relation(fields: [shiftId], references: [id])
  targetEmployee                   EmployeeDirectory?                @relation("TargetEmployee", fields: [targetEmployeeId], references: [id])
  unsafeActType                    UnsafeActType?                    @relation(fields: [unsafeActTypeId], references: [id])
  unsafeConditionType              UnsafeConditionType?              @relation(fields: [unsafeConditionTypeId], references: [id])
  validatedByUser                  User?                             @relation("ValidatedByUser", fields: [validatedBy], references: [id])
  workstation                      Workstation?                      @relation(fields: [workstationId], references: [id])
  attachments                      CommunicationAttachment[]
  involvedEmployees                CommunicationInvolvedEmployee[]
  mapFeatures                      MapFeature[]
  sewoRecords                      SEWO[]
  sewoAutoCreationSuppression      SewoAutoCreationSuppression?
  safetyCommunicationNotifications SafetyCommunicationNotification[]
  smatAudits                       SmatAudit[]

  @@index([plantId, status, eventDatetime])
  @@index([tipo, codigoFabrica, ano, numeroSequencial])
  @@index([riskThemeId, eventDatetime])
  @@index([unsafeConditionTypeId, eventDatetime])
  @@index([shiftId])
}

model CommunicationInvolvedEmployee {
  id              String            @id @default(uuid())
  communicationId String
  employeeId      String
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  communication   Communication     @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  employee        EmployeeDirectory @relation(fields: [employeeId], references: [id])

  @@unique([communicationId, employeeId])
  @@index([communicationId, sortOrder])
  @@index([employeeId])
}

model CommunicationAttachment {
  id               String        @id @default(uuid())
  communicationId  String
  fileKey          String
  fileName         String
  contentType      String
  createdAt        DateTime      @default(now())
  uploadedByUserId String?
  originalName     String?
  size             Int?
  communication    Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  uploadedByUser   User?         @relation(fields: [uploadedByUserId], references: [id])

  @@index([communicationId])
}

model Action {
  id                  String                     @id @default(uuid())
  plantId             String
  sourceType          ActionSourceType
  communicationId     String?
  sewoId              String?
  category            ActionCategory
  priority            ActionPriority
  title               String
  description         String
  ownerUserId         String
  dueDate             DateTime
  status              ActionStatus               @default(OPEN)
  closedAt            DateTime?
  closedBy            String?
  closureComment      String?
  reopenedAt          DateTime?
  reopenedBy          String?
  reopenReason        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  sequenceNumber      Int?
  level               RecordLevel?
  manualOrigin        ActionManualOrigin?
  closedByUser        User?                      @relation("ActionClosedBy", fields: [closedBy], references: [id])
  communication       Communication?             @relation(fields: [communicationId], references: [id])
  ownerUser           User                       @relation("ActionOwner", fields: [ownerUserId], references: [id])
  plant               Plant                      @relation(fields: [plantId], references: [id], onDelete: Cascade)
  reopenedByUser      User?                      @relation("ActionReopenedBy", fields: [reopenedBy], references: [id])
  sewo                SEWO?                      @relation(fields: [sewoId], references: [id])
  alertDeliveries     ActionAlertDelivery[]
  coOwners            ActionCoOwner[]
  evidenceAttachments ActionEvidenceAttachment[]
  sewoLinks           SEWOActionLink[]
  smatLinks           SmatAuditActionLink[]
  competenceLinks     CompetenceActionLink[]
  fireEquipmentLinks  FireEquipmentActionLink[]

  @@unique([plantId, sequenceNumber])
  @@index([plantId, status, dueDate])
