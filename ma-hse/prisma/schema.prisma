generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id                                 String                              @id @default(uuid())
  code                               String                              @unique
  name                               String
  timezone                           String
  defaultLanguage                    String
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  isActive                           Boolean                             @default(true)
  actions                            Action[]
  agentPendingConfirmations          AgentPendingConfirmation[]
  alertRules                         AlertRule[]
  areas                              Area[]
  auditLogs                          AuditLog[]
  bodyParts                          BodyPart[]
  communications                     Communication[]
  employees                          EmployeeDirectory[]
  equipments                         Equipment[]
  externalCompanies                  ExternalCompany[]
  externalInvitations                ExternalCompanyInvitation[]
  injuryTypes                        InjuryType[]
  lines                              Line[]
  mapDocuments                       MapDocument[]
  mapFeatures                        MapFeature[]
  mapLayers                          MapLayer[]
  nearMissTypes                      NearMissType[]
  notifications                      Notification[]
  accessTokens                       PlantAccessToken[]
  monthlyInputs                      PlantMonthlyInput[]
  recipientLists                     ReportRecipientList[]
  reportRuns                         ReportRun[]
  riskThemes                         RiskTheme[]
  sewoRecords                        SEWO[]
  safetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[]
  safetyCommunicationNotifications   SafetyCommunicationNotification[]
  kpiInputs                          SafetyKpiMonthlyInput[]
  shifts                             Shift[]
  smatAudits                         SmatAudit[]
  systemParameters                   SystemParameter[]
  unsafeActTypes                     UnsafeActType[]
  unsafeCondTypes                    UnsafeConditionType[]
  users                              UserPlantRole[]
  workstations                       Workstation[]
}

model User {
  id                                        String                              @id @default(uuid())
  email                                     String?                             @unique
  passwordHash                              String?
  name                                      String
  language                                  String                              @default("pt")
  isActive                                  Boolean                             @default(true)
  createdAt                                 DateTime                            @default(now())
  updatedAt                                 DateTime                            @updatedAt
  emailVerified                             DateTime?
  image                                     String?
  forcePasswordChange                       Boolean                             @default(false)
  onboardingStatus                          OnboardingStatus                    @default(NOT_STARTED)
  onboardingVersion                         Int                                 @default(0)
  onboardingStartedAt                       DateTime?
  onboardingCompletedAt                     DateTime?
  currentOnboardingStep                     Int                                 @default(0)
  accounts                                  Account[]
  actionClosed                              Action[]                            @relation("ActionClosedBy")
  actionsOwned                              Action[]                            @relation("ActionOwner")
  actionReopened                            Action[]                            @relation("ActionReopenedBy")
  actionAlertDeliveries                     ActionAlertDelivery[]
  actionCoOwned                             ActionCoOwner[]
  actionEvidenceAtt                         ActionEvidenceAttachment[]
  agentPendingConfirmations                 AgentPendingConfirmation[]
  auditLogs                                 AuditLog[]
  authenticators                            Authenticator[]
  manualClosedCommunications                Communication[]                     @relation("ManuallyClosedByUser")
  reportedCommunications                    Communication[]                     @relation("ReporterUser")
  validatedCommunications                   Communication[]                     @relation("ValidatedByUser")
  communicationAtt                          CommunicationAttachment[]
  contractorCompanies                       ExternalCompany[]                   @relation("ExternalContractorOwner")
  reviewedExternalCompanyDocuments          ExternalCompanyDocument[]           @relation("ExternalCompanyDocumentReviewer")
  contractorInvitationsSent                 ExternalCompanyInvitation[]         @relation("ExternalInvitationSponsor")
  reviewedExternalWorkerDocuments           ExternalWorkerDocument[]            @relation("ExternalWorkerDocumentReviewer")
  notifications                             Notification[]
  sewoApproved                              SEWO[]                              @relation("SewoApprovedBy")
  sewoPerformed                             SEWO[]                              @relation("SewoPerformedBy")
  sewoAttachment                            SEWOAttachment[]
  createdSafetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientCreatedBy")
  updatedSafetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientUpdatedBy")
  safetyCommunicationAlertRecipients        SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientUser")
  safetyCommunicationNotifications          SafetyCommunicationNotification[]   @relation("SafetyCommunicationNotificationRecipient")
  sessions                                  Session[]
  smatAuditsCreated                         SmatAudit[]                         @relation("SMATAuditorUser")
  smatAttachment                            SmatAuditAttachment[]
  plantRoles                                UserPlantRole[]
}

model Role {
  id        String          @id @default(uuid())
  code      RoleCode        @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     UserPlantRole[]
}

model UserPlantRole {
  id        String   @id @default(uuid())
  userId    String
  plantId   String?
  roleId    String
  createdAt DateTime @default(now())
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId, roleId])
  @@index([plantId])
  @@index([roleId])
}

model PlantAccessToken {
  id        String               @id @default(uuid())
  plantId   String
  type      PlantAccessTokenType
  tokenHash String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  revokedAt DateTime?
  createdBy String?
  plant     Plant                @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, type, tokenHash])
  @@index([plantId, type, isActive])
}

model Area {
  id                                 String                              @id @default(uuid())
  plantId                            String
  code                               String
  name                               String
  isActive                           Boolean                             @default(true)
  sourceLanguage                     String?
  plant                              Plant                               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  communications                     Communication[]
  mapFeatures                        MapFeature[]
  sewoRecords                        SEWO[]
  safetyCommunicationAlertRecipients SafetyCommunicationAlertRecipient[] @relation("SafetyCommunicationAlertRecipientDepartment")
  safetyCommunicationNotifications   SafetyCommunicationNotification[]   @relation("SafetyCommunicationNotificationDepartment")

  @@unique([plantId, code])
}

model Line {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sewoRecords    SEWO[]

  @@unique([plantId, code])
}

model Workstation {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  sourceLanguage String?
  communications Communication[]
  mapFeatures    MapFeature[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model Equipment {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  sourceLanguage String?
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model Shift {
  id             String              @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean             @default(true)
  communications Communication[]
  employees      EmployeeDirectory[]
  sewoRecords    SEWO[]
  plant          Plant               @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model RiskTheme {
  id                     String          @id @default(uuid())
  plantId                String
  code                   String
  name                   String
  isActive               Boolean         @default(true)
  category               String          @default("General")
  sourceLanguage         String?
  categorySourceLanguage String?
  communications         Communication[]
  plant                  Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model MasterDataTranslation {
  id           String                      @id @default(uuid())
  entityType   MasterDataEntityType
  entityId     String
  field        MasterDataTranslationField  @default(NAME)
  locale       String
  value        String?
  sourceHash   String
  status       MasterDataTranslationStatus @default(PENDING)
  isManual     Boolean                     @default(false)
  attempts     Int                         @default(0)
  lastError    String?
  translatedAt DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
  @@index([status, updatedAt])
}

model UnsafeActType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  category       String          @default("General")
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model UnsafeConditionType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  category       String          @default("General")
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
  @@index([plantId, category])
}

model NearMissType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model BodyPart {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  communications Communication[]

  @@unique([plantId, code])
}

model InjuryType {
  id             String          @id @default(uuid())
  plantId        String
  code           String
  name           String
  isActive       Boolean         @default(true)
  communications Communication[]
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, code])
}

model EmployeeDirectory {
  id                           String                          @id @default(uuid())
  plantId                      String
  employeeNo                   String
  name                         String
  dept                         String?
  shiftId                      String?
  isActive                     Boolean                         @default(true)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  targetCommunications         Communication[]                 @relation("TargetEmployee")
  involvedCommunications       CommunicationInvolvedEmployee[]
  plant                        Plant                           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  shift                        Shift?                          @relation(fields: [shiftId], references: [id])
  contractorCompanyAssignments ExternalCompany[]               @relation("ExternalContractorSponsor")

  @@unique([plantId, employeeNo])
  @@index([plantId, name])
}

model Communication {
  id                               String                            @id @default(uuid())
  plantId                          String
  type                             CommunicationType
  status                           CommunicationStatus               @default(SUBMITTED)
  source                           CommunicationSource               @default(BACKOFFICE)
  eventDatetime                    DateTime
  reportedAt                       DateTime                          @default(now())
  reporterName                     String
  reporterEmployeeNo               String?
  reporterUserId                   String?
  targetText                       String?
  targetEmployeeNo                 String?
  targetEmployeeId                 String?
  areaId                           String?
  lineId                           String?
  workstationId                    String?
  equipmentId                      String?
  riskThemeId                      String?
  unsafeActTypeId                  String?
  unsafeConditionTypeId            String?
  nearMissTypeId                   String?
  description                      String
  severityPotential                SeverityPotential?
  isContractor                     Boolean?                          @default(false)
  bodyPartId                       String?
  injuryTypeId                     String?
  hasLeave                         Boolean?                          @default(false)
  returnDate                       DateTime?
  lostDays                         Int?
  classification                   LeaveClassification?
  validationNotes                  String?
  validatedBy                      String?
  validatedAt                      DateTime?
  invalidationReason               String?
  manuallyClosedBy                 String?
  manuallyClosedAt                 DateTime?
  manualCloseReason                String?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  suggestedAction                  String?
  isFatal                          Boolean?                          @default(false)
  initialLostDays                  Int?
  shiftId                          String?
  level                            RecordLevel?
  improvementSubtype               CommunicationImprovementSubtype?
  codigoCompleto                   String?                           @unique
  codigoAbreviado                  String?
  tipo                             String?
  codigoFabrica                    String?
  ano                              Int?
  numeroSequencial                 Int?
  actions                          Action[]
  alertEvents                      AlertEvent[]
  area                             Area?                             @relation(fields: [areaId], references: [id])
  bodyPart                         BodyPart?                         @relation(fields: [bodyPartId], references: [id])
  equipment                        Equipment?                        @relation(fields: [equipmentId], references: [id])
  injuryType                       InjuryType?                       @relation(fields: [injuryTypeId], references: [id])
  line                             Line?                             @relation(fields: [lineId], references: [id])
  manuallyClosedByUser             User?                             @relation("ManuallyClosedByUser", fields: [manuallyClosedBy], references: [id])
  nearMissType                     NearMissType?                     @relation(fields: [nearMissTypeId], references: [id])
  plant                            Plant                             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  reporterUser                     User?                             @relation("ReporterUser", fields: [reporterUserId], references: [id])
  riskTheme                        RiskTheme?                        @relation(fields: [riskThemeId], references: [id])
  shift                            Shift?                            @relation(fields: [shiftId], references: [id])
  targetEmployee                   EmployeeDirectory?                @relation("TargetEmployee", fields: [targetEmployeeId], references: [id])
  unsafeActType                    UnsafeActType?                    @relation(fields: [unsafeActTypeId], references: [id])
  unsafeConditionType              UnsafeConditionType?              @relation(fields: [unsafeConditionTypeId], references: [id])
  validatedByUser                  User?                             @relation("ValidatedByUser", fields: [validatedBy], references: [id])
  workstation                      Workstation?                      @relation(fields: [workstationId], references: [id])
  attachments                      CommunicationAttachment[]
  involvedEmployees                CommunicationInvolvedEmployee[]
  mapFeatures                      MapFeature[]
  sewoRecords                      SEWO[]
  safetyCommunicationNotifications SafetyCommunicationNotification[]
  smatAudits                       SmatAudit[]

  @@index([plantId, status, eventDatetime])
  @@index([tipo, codigoFabrica, ano, numeroSequencial])
  @@index([riskThemeId, eventDatetime])
  @@index([unsafeConditionTypeId, eventDatetime])
  @@index([shiftId])
}

model CommunicationInvolvedEmployee {
  id              String            @id @default(uuid())
  communicationId String
  employeeId      String
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  communication   Communication     @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  employee        EmployeeDirectory @relation(fields: [employeeId], references: [id])

  @@unique([communicationId, employeeId])
  @@index([communicationId, sortOrder])
  @@index([employeeId])
}

model CommunicationAttachment {
  id               String        @id @default(uuid())
  communicationId  String
  fileKey          String
  fileName         String
  contentType      String
  createdAt        DateTime      @default(now())
  uploadedByUserId String?
  originalName     String?
  size             Int?
  communication    Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  uploadedByUser   User?         @relation(fields: [uploadedByUserId], references: [id])

  @@index([communicationId])
}

model Action {
  id                  String                     @id @default(uuid())
  plantId             String
  sourceType          ActionSourceType
  communicationId     String?
  sewoId              String?
  category            ActionCategory
  priority            ActionPriority
  title               String
  description         String
  ownerUserId         String
  dueDate             DateTime
  status              ActionStatus               @default(OPEN)
  closedAt            DateTime?
  closedBy            String?
  closureComment      String?
  reopenedAt          DateTime?
  reopenedBy          String?
  reopenReason        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  sequenceNumber      Int?
  level               RecordLevel?
  manualOrigin        ActionManualOrigin?
  closedByUser        User?                      @relation("ActionClosedBy", fields: [closedBy], references: [id])
  communication       Communication?             @relation(fields: [communicationId], references: [id])
  ownerUser           User                       @relation("ActionOwner", fields: [ownerUserId], references: [id])
  plant               Plant                      @relation(fields: [plantId], references: [id], onDelete: Cascade)
  reopenedByUser      User?                      @relation("ActionReopenedBy", fields: [reopenedBy], references: [id])
  sewo                SEWO?                      @relation(fields: [sewoId], references: [id])
  alertDeliveries     ActionAlertDelivery[]
  coOwners            ActionCoOwner[]
  evidenceAttachments ActionEvidenceAttachment[]
  sewoLinks           SEWOActionLink[]
  smatLinks           SmatAuditActionLink[]

  @@unique([plantId, sequenceNumber])
  @@index([plantId, status, dueDate])
}

model SmatAudit {
  id                        String                @id @default(uuid())
  plantId                   String
  auditorUserId             String?
  auditorName               String
  auditDate                 DateTime
  startTimeText             String?
  endTimeText               String?
  areaExamined              String?
  locationExamined          String?
  peopleObservedCount       Int                   @default(0)
  peopleInvolvedCount       Int                   @default(0)
  peopleSafeCount           Int                   @default(0)
  peopleUnsafeCount         Int                   @default(0)
  workConditionsSafeCount   Int                   @default(0)
  workConditionsUnsafeCount Int                   @default(0)
  reactionsPositiveCount    Int                   @default(0)
  reactionsNegativeCount    Int                   @default(0)
  safeActs                  Json
  safeConditions            Json
  unsafeActs                Json
  unsafeConditions          Json
  answer1                   String?
  answer2                   String?
  answer3                   String?
  answer4                   String?
  answer5                   String?
  answer6                   String?
  notes                     String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  communicationId           String?
  auditorUser               User?                 @relation("SMATAuditorUser", fields: [auditorUserId], references: [id])
  communication             Communication?        @relation(fields: [communicationId], references: [id])
  plant                     Plant                 @relation(fields: [plantId], references: [id], onDelete: Cascade)
  actionLinks               SmatAuditActionLink[]
  attachments               SmatAuditAttachment[]

  @@index([plantId, auditDate])
  @@index([auditorUserId, createdAt])
  @@index([communicationId])
}

model SmatAuditAttachment {
  id           String    @id @default(uuid())
  smatAuditId  String
  fileKey      String
  fileName     String
  contentType  String
  uploadedAt   DateTime  @default(now())
  uploadedById String?
  caption      String?
  smatAudit    SmatAudit @relation(fields: [smatAuditId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])

  @@index([smatAuditId])
}

model SmatAuditActionLink {
  id          String    @id @default(uuid())
  smatAuditId String
  actionId    String
  createdAt   DateTime  @default(now())
  action      Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  smatAudit   SmatAudit @relation(fields: [smatAuditId], references: [id], onDelete: Cascade)

  @@unique([smatAuditId, actionId])
  @@index([actionId])
}

model ExternalCompany {
  id                String                        @id @default(uuid())
  plantId           String
  sponsorUserId     String?
  sponsorEmployeeId String?
  email             String                        @unique
  passwordHash      String
  companyName       String
  address           String
  phone             String
  taxId             String
  socialSecurityId  String
  contactName       String
  isActive          Boolean                       @default(true)
  approvalStatus    ExternalCompanyApprovalStatus @default(PENDING)
  approvedUntil     DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  plant             Plant                         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sponsorEmployee   EmployeeDirectory?            @relation("ExternalContractorSponsor", fields: [sponsorEmployeeId], references: [id])
  sponsorUser       User?                         @relation("ExternalContractorOwner", fields: [sponsorUserId], references: [id])
  documents         ExternalCompanyDocument[]
  invitations       ExternalCompanyInvitation[]
  sessions          ExternalCompanySession[]
  workers           ExternalWorker[]
}

model ExternalCompanyInvitation {
  id                String           @id @default(uuid())
  plantId           String
  sponsorUserId     String
  email             String
  tokenHash         String           @unique
  requiredDocuments Json
  sentAt            DateTime         @default(now())
  acceptedAt        DateTime?
  companyId         String?
  company           ExternalCompany? @relation(fields: [companyId], references: [id])
  plant             Plant            @relation(fields: [plantId], references: [id], onDelete: Cascade)
  sponsorUser       User             @relation("ExternalInvitationSponsor", fields: [sponsorUserId], references: [id], onDelete: Cascade)

  @@index([plantId, email])
}

model ExternalCompanySession {
  id           String          @id @default(uuid())
  companyId    String
  sessionToken String          @unique
  expiresAt    DateTime
  createdAt    DateTime        @default(now())
  company      ExternalCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
}

model ExternalCompanyDocument {
  id               String                        @id @default(uuid())
  companyId        String
  type             ExternalCompanyDocumentType
  fileKey          String
  fileName         String
  contentType      String
  validUntil       DateTime?
  approvalStatus   ExternalCompanyApprovalStatus @default(PENDING)
  approvalComment  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  company          ExternalCompany               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedByUser   User?                         @relation("ExternalCompanyDocumentReviewer", fields: [reviewedByUserId], references: [id])

  @@unique([companyId, type])
}

model ExternalWorker {
  id             String                        @id @default(uuid())
  companyId      String
  name           String
  birthDate      DateTime
  isActive       Boolean                       @default(true)
  approvalStatus ExternalCompanyApprovalStatus @default(PENDING)
  approvedUntil  DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  company        ExternalCompany               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents      ExternalWorkerDocument[]

  @@index([companyId, isActive])
}

model ExternalWorkerDocument {
  id               String                        @id @default(uuid())
  workerId         String
  type             ExternalWorkerDocumentType
  fileKey          String
  fileName         String
  contentType      String
  validUntil       DateTime?
  approvalStatus   ExternalCompanyApprovalStatus @default(PENDING)
  approvalComment  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  reviewedByUser   User?                         @relation("ExternalWorkerDocumentReviewer", fields: [reviewedByUserId], references: [id])
  worker           ExternalWorker                @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, type])
}

model MapDocument {
  id                 String            @id @default(uuid())
  plantId            String
  title              String
  fileKey            String
  fileName           String
  contentType        String
  fileType           MapSourceFileType
  importedLayerNames Json?
  selectedLayerNames Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  plant              Plant             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  layers             MapLayer[]

  @@index([plantId, createdAt])
}

model MapLayer {
  id               String             @id @default(uuid())
  plantId          String
  documentId       String?
  name             String
  description      String?
  color            String             @default("#0f766e")
  icon             String?
  sourceType       MapLayerSourceType @default(MANUAL)
  isVisibleDefault Boolean            @default(true)
  sortOrder        Int                @default(0)
  metadataJson     Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  features         MapFeature[]
  document         MapDocument?       @relation(fields: [documentId], references: [id])
  plant            Plant              @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, sortOrder])
}

model MapFeature {
  id              String         @id @default(uuid())
  plantId         String
  layerId         String?
  featureType     MapFeatureType
  label           String
  icon            String?
  color           String?
  positionX       Float
  positionY       Float
  areaId          String?
  workstationId   String?
  communicationId String?
  metadataJson    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  area            Area?          @relation(fields: [areaId], references: [id])
  communication   Communication? @relation(fields: [communicationId], references: [id])
  layer           MapLayer?      @relation(fields: [layerId], references: [id])
  plant           Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  workstation     Workstation?   @relation(fields: [workstationId], references: [id])

  @@index([plantId, layerId])
}

model ActionCoOwner {
  id        String   @id @default(uuid())
  actionId  String
  userId    String
  createdAt DateTime @default(now())
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([actionId, userId])
}

model ActionAlertDelivery {
  id             String             @id @default(uuid())
  actionId       String
  userId         String
  alertType      ActionAlertType
  channel        ActionAlertChannel
  notificationId String?
  sentAt         DateTime           @default(now())
  createdAt      DateTime           @default(now())
  action         Action             @relation(fields: [actionId], references: [id], onDelete: Cascade)
  notification   Notification?      @relation(fields: [notificationId], references: [id])
