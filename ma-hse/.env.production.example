# Docker/host binding
APP_PORT=3004

# Public URLs. Use the final external URL users open in the browser.
# If Nginx/HTTPS is in front, do not use the internal app port here.
NODE_ENV=production
APP_ENV=production
# Set manually for every publication. Examples: 2.4.0, Release 2026.07, Produção 3.1
DEPLOY_VERSION=CHANGE_ME_FOR_EACH_DEPLOY
APP_URL=https://maxsafety.maportugal.com
NEXT_PUBLIC_APP_URL=https://maxsafety.maportugal.com
NEXTAUTH_URL=https://maxsafety.maportugal.com
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3004

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
TOKEN_PEPPER=CHANGE_ME_LONG_RANDOM_TOKEN_PEPPER

# PostgreSQL container credentials and app connection string.
POSTGRES_USER=ehs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ehs
DATABASE_URL=postgresql://ehs:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/ehs

# Redis is internal to Docker in production.
REDIS_URL=redis://redis:6379

# MinIO is an S3-compatible file store used for attachments/evidence.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_BUCKET=ehs-attachments
S3_FORCE_PATH_STYLE=true

# SMTP for password provisioning, magic links and notifications.
SMTP_HOST=posta2.it.ma.gruppocln.com
SMTP_PORT=587
SMTP_USER=safetyreport@pt.ma.gruppocln.com
SMTP_PASS=Cumulus21!
SMTP_FROM="SAFETY REPORT <safetyreport@pt.ma.gruppocln.com>"

# Optional OpenAI integrations. Server-side only; never expose this as NEXT_PUBLIC.
AGENT_ENABLED=true
AGENT_MOCK_MODE=true
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_MAX_REQUESTS=20
AGENT_MAX_MESSAGE_CHARS=4000
AGENT_REQUEST_TIMEOUT_MS=30000
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_OUTPUT_CHARS=4000
OPENAI_API_KEY=
TRANSLATION_PROVIDER=openai
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1

# Public report rate limiting.
RATE_LIMIT_POINTS=60
RATE_LIMIT_WINDOW_SEC=60

# Credentials login rate limiting.
AUTH_LOGIN_RATE_LIMIT_POINTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
AUTH_LOGIN_RATE_LIMIT_BURST=3

# Used by db:seed and admin:ensure-n0.
SEED_DEFAULT_PASSWORD=CHANGE_ME_TEMPORARY_SEED_PASSWORD
N0_ADMIN_EMAIL=admin@maxsafety.com
