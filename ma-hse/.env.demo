# Local demo environment (npm run demo). Fictitious, local-only values.
# Never point this at real data: DEMO_MODE refuses any database other than a
# local "ehs_demo" (lib/demo-mode.ts).
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NODE_ENV=development
APP_ENV=development
DEPLOY_VERSION=Demo
APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3100
NEXTAUTH_SECRET=demo-secret-not-for-production-0001
TOKEN_PEPPER=demo-pepper-not-for-production-0001
DATABASE_URL=postgresql://ehs:ehs@localhost:5434/ehs_demo
REDIS_URL=redis://localhost:6381
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=ehs-demo-attachments
S3_FORCE_PATH_STYLE=true
# Email and AI are disabled in the demo. Empty values override the dev .env,
# so real keys from the development environment never reach the demo.
SMTP_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_ENABLED=true
AGENT_MOCK_MODE=true
AGENT_PROVIDER=openai
TRANSLATION_PROVIDER=disabled
INCIDENT_KNOWLEDGE_EXTRACTION_PROVIDER=disabled
REPORT_QR_REGENERATION_ENABLED=false
NEXT_DIST_DIR=.next-demo
